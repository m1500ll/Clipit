# Copy to .env:  cp .env.example .env   — then paste the values from Supabase → Project Settings → API.
# The publishable (anon) key is designed to be public (data is protected by Row Level Security).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# NEVER put the service_role key, the Gemini key or the Stripe secret key in a VITE_ variable.
# Without these two values the app runs in demo mode (no account, sample AI results, real exports).
